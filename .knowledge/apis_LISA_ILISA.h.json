{"is_source_file": true, "format": "C++ header file", "description": "This file defines an interface (`ILISA`) for interacting with the Liberty Global Service's Application Lifecycle Interface (LISA). It includes methods for installing, uninstalling, downloading applications, managing storage and metadata, handling notifications, and managing application locks, among other functionalities. The file primarily contains interface definitions and related nested structures, focusing on the application's lifecycle and metadata management.", "external_files": ["Module.h", "Core/IUnknown.h"], "external_methods": ["Core::IUnknown"], "published": ["ILISA"], "classes": [{"name": "ILISA", "description": "Interface for the Application Lifecycle Service, providing methods for app installation, uninstallation, download, metadata management, storage handling, notifications, app listing, and lock management. Contains nested interfaces for storage, metadata, key-value pairs, notifications, app versions, apps, and lock info."}, {"name": "ILISA::IStorage", "description": "Interface for storage details, providing methods to get storage path, quota, and used space."}, {"name": "ILISA::IStoragePayload", "description": "Interface for storage payload data, providing methods to access apps and persistent storage."}, {"name": "ILISA::IKeyValue", "description": "Interface for key-value pairs, providing methods to get key and value."}, {"name": "ILISA::IKeyValueIterator", "description": "Iterator over key-value pairs, with methods to traverse and access current key-value."}, {"name": "ILISA::IMetadataPayload", "description": "Interface representing application metadata, resources, and auxiliary metadata."}, {"name": "ILISA::IAppVersion", "description": "Represents application version details, including methods to access version, app name, category, and URL."}, {"name": "ILISA::IApp", "description": "Represents application details, including type, ID, and versions."}, {"name": "ILISA::IAppsPayload", "description": "Provides a collection of applications."}, {"name": "ILISA::IHandleResult", "description": "Result object encapsulating a handle string for application lock operations."}, {"name": "ILISA::ILockInfo", "description": "Contains lock information such as reason and owner."}], "methods": [{"name": "Install", "description": "Downloads and installs an application bundle given its type, ID, version, URL, app name, and category, returning a handle."}, {"name": "Uninstall", "description": "Uninstalls an application specified by type, ID, version, and uninstall type, returning a handle."}, {"name": "Download", "description": "Downloads an application's resource file given its type, ID, version, resource key, and URL, returning a handle."}, {"name": "Reset", "description": "Deletes persistent local data for a specified application."}, {"name": "GetStorageDetails", "description": "Retrieves storage details, returning storage payload information."}, {"name": "SetAuxMetadata", "description": "Sets an arbitrary auxiliary metadata key-value pair for an application."}, {"name": "ClearAuxMetadata", "description": "Clears an auxiliary metadata key for an application."}, {"name": "GetMetadata", "description": "Retrieves application metadata."}, {"name": "Cancel", "description": "Cancels an ongoing request by handle."}, {"name": "GetProgress", "description": "Provides progress percentage of a request by handle."}, {"name": "Register", "description": "Registers for notifications."}, {"name": "Unregister", "description": "Unregisters from notifications."}, {"name": "Configure", "description": "Configures the ILISA interface with a given configuration string."}, {"name": "GetList", "description": "Lists installed applications matching specified criteria."}, {"name": "Lock", "description": "Locks an application to prevent uninstallation, returning a handle."}, {"name": "Unlock", "description": "Unlocks a previously locked application using its handle."}, {"name": "GetLockInfo", "description": "Retrieves lock information for an application."}], "calls": ["Install", "Uninstall", "Download", "Reset", "GetStorageDetails", "SetAuxMetadata", "ClearAuxMetadata", "GetMetadata", "Cancel", "GetProgress", "Register", "Unregister", "Configure", "GetList", "Lock", "Unlock", "GetLockInfo", "operationStatus"], "search-terms": ["ILISA", "Application Lifecycle", "Install", "Uninstall", "Download", "Storage", "Metadata", "Lock", "Unlock", "Notification", "AppVersion", "App", "PersistentData", "Resource", "KeyValue", "MetadataPayload"], "state": 2, "file_id": 224, "knowledge_revision": 780, "git_revision": "2436f6afbbac3e771366e6cf6fae0434868d734d", "ctags": [{"_type": "tag", "name": "Exchange", "path": "/home/kavia/workspace/code-generation/entservices-apis-34/apis/LISA/ILISA.h", "pattern": "/^namespace Exchange {$/", "language": "C++", "kind": "namespace", "scope": "WPEFramework", "scopeKind": "namespace"}, {"_type": "tag", "name": "IApp", "path": "/home/kavia/workspace/code-generation/entservices-apis-34/apis/LISA/ILISA.h", "pattern": "/^        struct EXTERNAL IApp : virtual public Core::IUnknown {$/", "language": "C++", "kind": "struct", "scope": "WPEFramework::Exchange::ILISA", "scopeKind": "struct"}, {"_type": "tag", "name": "IAppVersion", "path": "/home/kavia/workspace/code-generation/entservices-apis-34/apis/LISA/ILISA.h", "pattern": "/^        struct EXTERNAL IAppVersion : virtual public Core::IUnknown {$/", "language": "C++", "kind": "struct", "scope": "WPEFramework::Exchange::ILISA", "scopeKind": "struct"}, {"_type": "tag", "name": "IAppsPayload", "path": "/home/kavia/workspace/code-generation/entservices-apis-34/apis/LISA/ILISA.h", "pattern": "/^        struct EXTERNAL IAppsPayload : virtual public Core::IUnknown {$/", "language": "C++", "kind": "struct", "scope": "WPEFramework::Exchange::ILISA", "scopeKind": "struct"}, {"_type": "tag", "name": "ID", "path": "/home/kavia/workspace/code-generation/entservices-apis-34/apis/LISA/ILISA.h", "p