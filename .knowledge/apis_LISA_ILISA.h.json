{"is_source_file": true, "format": "C++ Header File", "description": "This file defines the ILISA interface and related nested interfaces for a module managing application installation, uninstallation, storage, metadata, and application management functions within the WPEFramework ecosystem. It serves as a contract for implementing classes that interact with application lifecycle and storage management, including metadata handling and locking mechanisms.", "external_files": ["Module.h", "Core.h"], "external_methods": ["Core::IUnknown", "Core::String"], "published": ["WPEFramework::Exchange::ILISA"], "classes": [{"name": "ILISA", "description": "Main interface for application management operations including install, uninstall, download, reset, and metadata handling, as well as storage and lock management."}, {"name": "ILISA::IStorage", "description": "Interface for storage path, quota, and usage information."}, {"name": "ILISA::IStoragePayload", "description": "Interface providing access to application and persistent storage."}, {"name": "ILISA::IKeyValue", "description": "Interface representing a key-value pair."}, {"name": "ILISA::IKeyValueIterator", "description": "Iterator interface for traversing key-value pairs."}, {"name": "ILISA::IMetadataPayload", "description": "Contains application metadata details including app name, category, URL, resources, and auxiliary metadata."}, {"name": "ILISA::IAppVersion", "description": "Interface describing application version details; includes nested iterator."}, {"name": "ILISA::IApp", "description": "Represents an application with type, id, and versions; includes nested iterator."}, {"name": "ILISA::IAppsPayload", "description": "Interface for listing multiple applications."}, {"name": "ILISA::IHandleResult", "description": "Provides a handle string for application locking."}, {"name": "ILISA::ILockInfo", "description": "Contains lock information such as reason and owner."}], "methods": [{"name": "Install", "description": "