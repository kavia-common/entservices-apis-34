": "Notification when cookies are added, removed, or modified."}], "methods": [{"name": "Register", "description": "Registers a notification sink for browser events."}, {"name": "Unregister", "description": "Unregisters a notification sink for browser events."}, {"name": "SetURL", "description": "Sets the URL displayed in the browser."}, {"name": "GetURL", "description": "Retrieves the current URL loaded in the browser."}, {"name": "GetFPS", "description": "Gets current rendering FPS of the browser."}, {"name": "Hide", "description": "Hides or shows the browser."}, {"name": "LoadFinished", "description": "Notification that the load of a URL has finished."}, {"name": "URLChanged", "description": "Notification that the URL has changed."}, {"name": "Hidden", "description": "Notification of browser visibility change."}, {"name": "Closure", "description": "Notification that the browser is closing."}, {"name": "HeaderList", "description": "Retrieves or sets headers for browser requests."}, {"name": "UserAgent", "description": "Gets or sets the User-Agent string."}, {"name": "LocalStorageEnabled", "description": "Gets or sets the status of local storage."}, {"name": "HTTPCookieAcceptPolicy", "description": "Gets or sets the HTTP cookies acceptance policy."}, {"name": "BridgeReply", "description": "Sends a response payload for a bridge query."}, {"name": "BridgeEvent", "description": "Sends an event payload over the bridge."}, {"name": "CollectGarbage", "description": "Initiates garbage collection."}], "calls": ["Register", "Unregister", "SetURL", "GetURL", "GetFPS", "Hide"], "search-terms": ["IBrowser", "IWebBrowser", "Notification", "LoadFinished", "URLChange", "Bridge", "CookieJar", "SecurityPolicy", "Scripting", "Resources"], "state": 2, "file_id": 162, "knowledge_revision": 716, "git_revision": "2436f6afbbac3e771366e6cf6fae0434868d734d", "ctags": [{"_type": "tag", "name": "ALLOWED", "path": "/home/kavia/workspace/code-generation/entservices-apis-34/apis/WebKitBrowser/I